# GymEG WPPConnect + Always-On Worker Environment Variables
# Copy to .env on the Docker host and replace with strong random secrets.
# NEVER commit .env or expose these secrets to NEXT_PUBLIC_* variables.

# HTTPS origin of your deployed GYMEG Next.js app (e.g. https://gymeg.vercel.app)
GYMEG_API_BASE_URL=https://gymeg.vercel.app

# Shared HMAC-SHA256 secret (64+ hex chars) matching GYMEG_WPP_WORKER_SECRET in Vercel
GYMEG_WPP_WORKER_SECRET=replace_with_64_char_random_hex_secret

# WPPConnect Server internal secret key (used only inside Docker network)
WPP_SECRET_KEY=replace_with_strong_random_wpp_secret

# Polling interval in milliseconds (default 15000 = 15s)
WORKER_POLL_INTERVAL_MS=15000
