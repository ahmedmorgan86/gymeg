# Supabase PostgreSQL connection pooler (Session/Transaction pooler, port 5432 or 6543)
# Backend only. NEVER prefix with NEXT_PUBLIC_.
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# Supabase Public API configuration (safe for browser exposure)
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-ID].supabase.co
# Standard Supabase Anon Key (also supports NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Commercial Multi-Club Mode: set to 1 after applying commercial migrations & bootstrapping admin
GYMOS_COMMERCIAL=0

# Public SEO and canonical origin (must be valid HTTPS URL)
NEXT_PUBLIC_SITE_URL=https://gymeg.vercel.app
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=

# Optional SMS dispatch integration: disabled until isolated provider credentials configured
GYMOS_SMS_ENABLED=0
# JSON array of branch SMS configs, e.g. [{"branch":"main","provider":"custom","dailyLimit":100}]
GYMOS_SMS_CONNECTIONS=[]

# Optional physical access control bridge (turnstiles/RFID readers)
GYMOS_DEVICE_BRIDGE_ENABLED=0
GYMOS_DEVICE_BRIDGES=[]

