+export const membersFallbackQrPath = '/downloads/gymeg-member-qr.png';
+
+export interface AndroidVariantInfo {
+  id: AndroidVariantId;
+  version: string;
+  url: string;
+  filename: string;
+  minAndroid: string;
+  installPath: string;
+  mobileEntryPath: string;
+  fallbackQrPath: string;
+  iconPath: string;
+  arTitle: string;
+  enTitle: string;
+  arCta: string;
+  enCta: string;
+  arNavLabel: string;
+  enNavLabel: string;
+  arQrAlt: string;
+  enQrAlt: string;
