++  public AnnouncementScheduler(
++    string rootDir,
++    Action<bool> duckMusic,
++    Action<string> reportStatus,
++    Action<string> postWebMessage
++  ) {
++    DuckMusic = duckMusic;
++    ReportStatus = reportStatus;
++    PostWebMessage = postWebMessage;
