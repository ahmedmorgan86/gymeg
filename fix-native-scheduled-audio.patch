++        }
++        _ = Task.Run(() => {
++          try {
++            var bytes = File.ReadAllBytes(item.AudioFile);
++            PlayAudioInternal(item.Id, item.Name, bytes, true);
++          } catch (Exception ex) {
++            ReportStatus("فشل تشغيل النداء المجدول: " + ex.Message);
++          }
++        });
++      }
