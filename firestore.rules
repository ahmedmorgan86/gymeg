rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// This security rules file assumes the following data structures:
//
// Collection: gym_states
// Document ID: {ownerId} (Gym Owner UID)
// Fields:
//   - user_id: string (required, 1-128 chars, immutable, matches {ownerId})
//   - payload: string | map (required, string <= 1MB or map object)
//   - revision: int (required, integer >= 0, monotonic increment)
//   - updated_at: string | timestamp (required, ISO 8601 string or timestamp)
//
// Collection: gym_access
// Document ID: {ownerId}_{userId}
// Fields:
//   - owner_id: string (required, 1-128 chars, immutable)
//   - user_id: string (required, 1-128 chars, immutable)
//   - name: string (required, 1-128 chars)
//   - role: string (required, enum: 'manager' | 'reception')
//   - branches: list | string (required, branches allowed)
//   - revoked: int | bool (required, 0/1 or false/true)
//
// Collection: gym_invites
// Document ID: {tokenHash}
// Fields:
//   - token_hash: string (required, 16-128 chars, matches {tokenHash})
//   - owner_id: string (required, 1-128 chars, immutable)
//   - role: string (required, enum: 'manager' | 'reception')
//   - branches: string (required, 1-2048 chars)
//   - expires_at: timestamp | string (required, expiration deadline)
//   - claimed_by: string | null (optional/nullable, UID claiming the token)
//
// Collection: gym_entities
// Document ID: {ownerId}_{collection}_{entity_id}
// Fields:
//   - owner_id: string (required, 1-128 chars, immutable)
//   - collection: string (required, 1-64 chars, immutable)
//   - entity_id: string (required, 1-128 chars, immutable)
//   - position: int (optional, sort order)
//   - branch: string | null (optional, branch association)
//   - payload: map (required, entity state map)
//   - updated_at: string | timestamp (required)
//
// Collection: membership_cards
// Document ID: {cardCode}
// Fields:
//   - code: string (required, 1-128 chars, immutable, matches {cardCode})
//   - owner_id: string (required, 1-128 chars, immutable)
//   - member_id: string (required, 1-128 chars)
//   - branch: string | null (optional, branch code)
//   - status: string (required, status code, 1-32 chars)
//   - issue_date: string | timestamp | null (optional)
//   - expiry_date: string | timestamp | null (optional)
//   - created_at: string | timestamp | null (optional)
//   - payload: map | null (optional)
//
// Collection: workspace_events
// Document ID: {eventId}
// Fields:
//   - id: string (required, 1-128 chars, immutable, matches {eventId})
//   - owner_id: string (required, 1-128 chars, immutable)
//   - tenant_id: string (optional, 1-128 chars)
//   - revision: int (required, integer >= 0)
//   - event_type: string (required, 1-128 chars)
//   - collection: string | null (optional)
//   - entity_id: string | null (optional)
//   - branch: string | null (optional)
//   - operation: string | null (optional)
//   - payload: map (required)
//   - actor: string | null (optional)
//   - created_at: timestamp | string (required)
//
// Collection: workspace_outbox
// Document ID: {outboxId}
// Fields:
//   - id: string (required, 1-128 chars, immutable, matches {outboxId})
//   - owner_id: string (required, 1-128 chars, immutable)
//   - tenant_id: string (required, 1-128 chars, immutable)
//   - channel: string (required, 1-128 chars)
//   - event: string (required, 1-128 chars)
//   - payload: map (required)
//   - created_at: timestamp | string | null (optional)
//   - processed_at: timestamp | string | null (optional)
//
// Collection: fcm_subscriptions
// Document ID: {subId}
// Fields:
//   - user_id: string (required, 1-128 chars, immutable)
//   - token: string (optional, FCM device token <= 4096 chars)
//   - token_ciphertext: string (optional, encrypted token <= 4096 chars)
//   - subscription_id: string (optional, <= 128 chars)
//   - owner_id: string (optional, <= 128 chars)
//   - branch: string (optional, <= 128 chars)
//   - recipient_type: string (optional, <= 32 chars)
//   - recipient_id: string (optional, <= 128 chars)
//   - device_type: string (optional, <= 64 chars)
//   - created_at: timestamp | string (required)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isStaff(ownerId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/gym_access/$(ownerId + '_' + request.auth.uid)) &&
        (
          get(/databases/$(database)/documents/gym_access/$(ownerId + '_' + request.auth.uid)).data.revoked == false ||
          get(/databases/$(database)/documents/gym_access/$(ownerId + '_' + request.auth.uid)).data.revoked == 0
        );
    }

    function canManageGym(ownerId) {
      return isOwner(ownerId) || isStaff(ownerId);
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function isValidTimestampOrIso(val) {
      return (val is timestamp) || (val is string && val.size() > 0 && val.size() <= 64);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidGymState(data) {
      return hasRequiredFields(['user_id', 'payload', 'revision', 'updated_at']) &&
        data.user_id is string && data.user_id.size() > 0 && data.user_id.size() <= 128 &&
        data.revision is int && data.revision >= 0 &&
        ((data.payload is string && data.payload.size() <= 1048576) || (data.payload is map)) &&
        isValidTimestampOrIso(data.updated_at);
    }

    function isValidGymAccess(data) {
      return hasRequiredFields(['owner_id', 'user_id', 'name', 'role', 'branches', 'revoked']) &&
        data.owner_id is string && data.owner_id.size() > 0 && data.owner_id.size() <= 128 &&
        data.user_id is string && data.user_id.size() > 0 && data.user_id.size() <= 128 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 128 &&
        data.role in ['manager', 'reception'] &&
        ((data.branches is string && data.branches.size() <= 2048) || (data.branches is list && data.branches.size() <= 100)) &&
        (data.revoked is bool || (data.revoked is int && (data.revoked == 0 || data.revoked == 1)));
    }

    function isValidGymInvite(data) {
      return hasRequiredFields(['token_hash', 'owner_id', 'role', 'branches', 'expires_at']) &&
        data.token_hash is string && data.token_hash.size() >= 16 && data.token_hash.size() <= 128 &&
        data.owner_id is string && data.owner_id.size() > 0 && data.owner_id.size() <= 128 &&
        data.role in ['manager', 'reception'] &&
        data.branches is string && data.branches.size() <= 2048 &&
        isValidTimestampOrIso(data.expires_at) &&
        (!('claimed_by' in data) || data.claimed_by == null || (data.claimed_by is string && data.claimed_by.size() > 0 && data.claimed_by.size() <= 128));
    }

    function isValidGymEntity(data) {
      return hasRequiredFields(['owner_id', 'collection', 'entity_id', 'payload', 'updated_at']) &&
        data.owner_id is string && data.owner_id.size() > 0 && data.owner_id.size() <= 128 &&
        data.collection is string && data.collection.size() > 0 && data.collection.size() <= 64 &&
        data.entity_id is string && data.entity_id.size() > 0 && data.entity_id.size() <= 128 &&
        data.payload is map &&
        isValidTimestampOrIso(data.updated_at) &&
        (!('branch' in data) || data.branch == null || (data.branch is string && data.branch.size() <= 128)) &&
        (!('position' in data) || data.position is int);
    }

    function isValidMembershipCard(data) {
      return hasRequiredFields(['code', 'owner_id', 'member_id', 'status']) &&
        data.code is string && data.code.size() > 0 && data.code.size() <= 128 &&
        data.owner_id is string && data.owner_id.size() > 0 && data.owner_id.size() <= 128 &&
        data.member_id is string && data.member_id.size() > 0 && data.member_id.size() <= 128 &&
        data.status is string && data.status.size() > 0 && data.status.size() <= 32 &&
        (!('branch' in data) || data.branch == null || (data.branch is string && data.branch.size() <= 128)) &&
        (!('issue_date' in data) || data.issue_date == null || isValidTimestampOrIso(data.issue_date)) &&
        (!('expiry_date' in data) || data.expiry_date == null || isValidTimestampOrIso(data.expiry_date)) &&
        (!('created_at' in data) || data.created_at == null || isValidTimestampOrIso(data.created_at)) &&
        (!('payload' in data) || data.payload == null || data.payload is map);
    }

    function isValidWorkspaceEvent(data) {
      return hasRequiredFields(['id', 'owner_id', 'revision', 'event_type', 'payload', 'created_at']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.owner_id is string && data.owner_id.size() > 0 && data.owner_id.size() <= 128 &&
        data.revision is int && data.revision >= 0 &&
        data.event_type is string && data.event_type.size() > 0 && data.event_type.size() <= 128 &&
        data.payload is map &&
        isValidTimestampOrIso(data.created_at) &&
        (!('tenant_id' in data) || (data.tenant_id is string && data.tenant_id.size() <= 128)) &&
        (!('collection' in data) || (data.collection is string && data.collection.size() <= 64)) &&
        (!('entity_id' in data) || (data.entity_id is string && data.entity_id.size() <= 128)) &&
        (!('branch' in data) || data.branch == null || (data.branch is string && data.branch.size() <= 128)) &&
        (!('operation' in data) || data.operation == null || (data.operation is string && data.operation.size() <= 64)) &&
        (!('actor' in data) || data.actor == null || (data.actor is string && data.actor.size() <= 128));
    }

    function isValidWorkspaceOutbox(data) {
      return hasRequiredFields(['id', 'owner_id', 'tenant_id', 'channel', 'event', 'payload']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.owner_id is string && data.owner_id.size() > 0 && data.owner_id.size() <= 128 &&
        data.tenant_id is string && data.tenant_id.size() > 0 && data.tenant_id.size() <= 128 &&
        data.channel is string && data.channel.size() > 0 && data.channel.size() <= 128 &&
        data.event is string && data.event.size() > 0 && data.event.size() <= 128 &&
        data.payload is map &&
        (!('created_at' in data) || isValidTimestampOrIso(data.created_at)) &&
        (!('processed_at' in data) || data.processed_at == null || isValidTimestampOrIso(data.processed_at));
    }

    function isValidFcmSubscription(data) {
      return hasRequiredFields(['user_id', 'created_at']) &&
        data.user_id is string && data.user_id.size() > 0 && data.user_id.size() <= 128 &&
        isValidTimestampOrIso(data.created_at) &&
        (!('token' in data) || (data.token is string && data.token.size() > 0 && data.token.size() <= 4096)) &&
        (!('token_ciphertext' in data) || (data.token_ciphertext is string && data.token_ciphertext.size() > 0 && data.token_ciphertext.size() <= 4096)) &&
        (!('device_type' in data) || (data.device_type is string && data.device_type.size() <= 64)) &&
        (!('subscription_id' in data) || (data.subscription_id is string && data.subscription_id.size() <= 128)) &&
        (!('owner_id' in data) || (data.owner_id is string && data.owner_id.size() <= 128)) &&
        (!('branch' in data) || (data.branch is string && data.branch.size() <= 128)) &&
        (!('recipient_type' in data) || (data.recipient_type is string && data.recipient_type.size() <= 32)) &&
        (!('recipient_id' in data) || (data.recipient_id is string && data.recipient_id.size() <= 128));
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // 1. Gym master state: /gym_states/{ownerId}
    match /gym_states/{ownerId} {
      allow read: if canManageGym(ownerId);
      allow create: if canManageGym(ownerId) &&
        isValidGymState(request.resource.data) &&
        request.resource.data.user_id == ownerId;
      allow update: if canManageGym(ownerId) &&
        isValidGymState(request.resource.data) &&
        request.resource.data.user_id == resource.data.user_id &&
        request.resource.data.revision >= resource.data.revision;
      allow delete: if isOwner(ownerId);
    }

    // 2. Gym access control: /gym_access/{accessId}
    match /gym_access/{accessId} {
      allow read: if isAuthenticated() &&
        (request.auth.uid == resource.data.owner_id || request.auth.uid == resource.data.user_id);
      allow create: if isOwner(request.resource.data.owner_id) &&
        isValidGymAccess(request.resource.data) &&
        accessId == request.resource.data.owner_id + '_' + request.resource.data.user_id;
      allow update: if isOwner(resource.data.owner_id) &&
        isValidGymAccess(request.resource.data) &&
        request.resource.data.owner_id == resource.data.owner_id &&
        request.resource.data.user_id == resource.data.user_id;
      allow delete: if isOwner(resource.data.owner_id);
    }

    // 3. Gym staff invitations: /gym_invites/{tokenHash}
    match /gym_invites/{tokenHash} {
      allow read: if (isAuthenticated() && request.auth.uid == resource.data.owner_id) ||
        (
          resource.data.claimed_by == null &&
          (resource.data.expires_at is string || resource.data.expires_at > request.time)
        );
      allow create: if isOwner(request.resource.data.owner_id) &&
        isValidGymInvite(request.resource.data) &&
        request.resource.data.token_hash == tokenHash &&
        (!('claimed_by' in request.resource.data) || request.resource.data.claimed_by == null);
      allow update: if (
          // Case A: Owner updates invite
          isOwner(resource.data.owner_id) &&
          isValidGymInvite(request.resource.data) &&
          request.resource.data.token_hash == resource.data.token_hash &&
          request.resource.data.owner_id == resource.data.owner_id
        ) || (
          // Case B: User claims invite
          isAuthenticated() &&
          resource.data.claimed_by == null &&
          (resource.data.expires_at is string || resource.data.expires_at > request.time) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed_by']) &&
          request.resource.data.claimed_by == request.auth.uid &&
          isValidGymInvite(request.resource.data)
        );
      allow delete: if isOwner(resource.data.owner_id);
    }

    // 4. Normalized gym entities: /gym_entities/{entityDocId}
    match /gym_entities/{entityDocId} {
      allow read: if canManageGym(resource.data.owner_id);
      allow create: if canManageGym(request.resource.data.owner_id) &&
        isValidGymEntity(request.resource.data) &&
        entityDocId == request.resource.data.owner_id + '_' + request.resource.data.collection + '_' + request.resource.data.entity_id;
      allow update: if canManageGym(resource.data.owner_id) &&
        isValidGymEntity(request.resource.data) &&
        request.resource.data.owner_id == resource.data.owner_id &&
        request.resource.data.collection == resource.data.collection &&
        request.resource.data.entity_id == resource.data.entity_id;
      allow delete: if canManageGym(resource.data.owner_id);
    }

    // 5. Membership cards: /membership_cards/{cardCode}
    match /membership_cards/{cardCode} {
      allow read: if canManageGym(resource.data.owner_id);
      allow create: if canManageGym(request.resource.data.owner_id) &&
        isValidMembershipCard(request.resource.data) &&
        request.resource.data.code == cardCode;
      allow update: if canManageGym(resource.data.owner_id) &&
        isValidMembershipCard(request.resource.data) &&
        request.resource.data.code == resource.data.code &&
        request.resource.data.owner_id == resource.data.owner_id;
      allow delete: if isOwner(resource.data.owner_id);
    }

    // 6. Append-only workspace events: /workspace_events/{eventId}
    match /workspace_events/{eventId} {
      allow read: if isOwner(resource.data.owner_id);
      allow create: if isOwner(request.resource.data.owner_id) &&
        isValidWorkspaceEvent(request.resource.data) &&
        request.resource.data.id == eventId;
      allow update: if false;
      allow delete: if false;
    }

    // 7. Workspace outbox: /workspace_outbox/{outboxId}
    match /workspace_outbox/{outboxId} {
      allow read: if isOwner(resource.data.owner_id);
      allow create: if isOwner(request.resource.data.owner_id) &&
        isValidWorkspaceOutbox(request.resource.data) &&
        request.resource.data.id == outboxId;
      allow update: if isOwner(resource.data.owner_id) &&
        isValidWorkspaceOutbox(request.resource.data) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.owner_id == resource.data.owner_id &&
        request.resource.data.tenant_id == resource.data.tenant_id;
      allow delete: if isOwner(resource.data.owner_id);
    }

    // 8. User device push subscriptions: /fcm_subscriptions/{subId}
    match /fcm_subscriptions/{subId} {
      allow read: if isOwner(resource.data.user_id);
      allow create: if isOwner(request.resource.data.user_id) &&
        isValidFcmSubscription(request.resource.data);
      allow update: if isOwner(resource.data.user_id) &&
        isValidFcmSubscription(request.resource.data) &&
        request.resource.data.user_id == resource.data.user_id;
      allow delete: if isOwner(resource.data.user_id);
    }

    // 9. Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
